# Copy this file to .env.local for local development and fill in real
# values there. .env.local is already git-ignored by create-next-app's
# default .gitignore — never commit real secrets.

# Resend (https://resend.com) API key used to send enquiry-form emails
# server-side from src/app/api/enquiry/route.ts. Server-only — never
# exposed to the browser (no NEXT_PUBLIC_ prefix).
RESEND_API_KEY=

# Inbox that should receive enquiry emails (the business owner's real,
# monitored address).
ENQUIRY_TO_EMAIL=

# Verified sender address/domain in Resend (Resend requires the sending
# domain to be verified before it will deliver). Format can be either a
# bare address or "Name <address@domain>".
ENQUIRY_FROM_EMAIL=
